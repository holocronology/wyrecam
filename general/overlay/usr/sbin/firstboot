#!/bin/sh
#
# Factory reset: erase the settings partition and reboot.
# This removes the Wi-Fi settings, root password, SSH settings, HomeKit
# pairings and your private HomeKit setup code. Afterwards root logins and SSH
# are off, the camera is offline, and it uses the public setup code again.
# Re-install from the SD card to set it up again.

if [ "$1" != "-y" ]; then
  echo "This erases all WyreCam settings and HomeKit pairings, then reboots."
  printf "Type 'yes' to continue: "
  read answer
  [ "$answer" = "yes" ] || exit 1
fi

dev=`awk -F ':' '/"rootfs_data"/ {print $1}' /proc/mtd`
[ -n "$dev" ] || { echo "rootfs_data partition not found"; exit 1; }
sync
flash_eraseall -j /dev/$dev && reboot -f
